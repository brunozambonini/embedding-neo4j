OPENROUTER_API_KEY='your_openrouter_api_key_here'
OPENROUTER_SITE_URL='https://openrouter.ai/api/v1/chat/completions'
OPENROUTER_SITE_NAME='RAG Example'
# Models
NLP_MODEL='google/gemma-3-4b-it:free'

#Embeddings (using Transformers.js locally)
EMBEDDINGS_MODEL='Xenova/all-MiniLM-L6-v2:free'

# Neo4j
NEO4J_URI='bolt://localhost:7687'
NEO4J_USER='neo4j'
NEO4J_PASSWORD='password'
NEO4J_DATABASE='neo4j'

# Vector search threshold
NEO4J_VECTOR_THRESHOLD=0.9